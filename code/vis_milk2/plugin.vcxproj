      <DataExecutionPrevention>false</DataExecutionPrevention>
      <ImageHasSafeExceptionHandlers>false</ImageHasSafeExceptionHandlers>
      <TargetMachine>MachineX86</TargetMachine>
    </Link>
    <PostBuildEvent>
      <Message>Staging runtime files (D3DX DLLs + Milkdrop2 data) next to the exe</Message>
      <Command>xcopy /Y /Q "$(D3DXRoot)release\bin\x86\D3DX9_43.dll" "$(OutDir)"
xcopy /Y /Q "$(D3DXRoot)release\bin\x86\D3DCompiler_43.dll" "$(OutDir)"
xcopy /Y /Q /E /I "$(RepoRoot)code\resources\Milkdrop2" "$(OutDir)plugins\Milkdrop2"
xcopy /Y /Q "$(RepoRoot)LICENSE.txt" "$(OutDir)"
if exist "$(RepoRoot)content\presets" xcopy /Y /Q /E /I /D "$(RepoRoot)content\presets" "$(OutDir)plugins\Milkdrop2\presets"
if exist "$(RepoRoot)content\textures" xcopy /Y /Q /E /I /D "$(RepoRoot)content\textures" "$(OutDir)plugins\Milkdrop2\textures"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
